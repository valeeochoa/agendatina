# Desactivar listado de directorios
Options -Indexes

# Bloquear cualquier intento de ejecutar o acceder a scripts o archivos sensibles
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash|exe|bat|cmd|dll|bin|htaccess|htpasswd|env|ini|config|bak)$">
    Require all denied
</FilesMatch>

# Asegurar que los archivos multimedia se sirvan con tipos seguros
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
